# Elastic Stack version — e.g. 8.15.0
STACK_VERSION=8.15.0

# Cluster name
CLUSTER_NAME=docker-cluster

# License type: basic or trial
LICENSE=basic

# Password for the 'elastic' superuser (must be at least 6 characters)
ELASTIC_PASSWORD=changeme

# Password for the internal 'kibana_system' user
KIBANA_PASSWORD=changeme

# Host port that Elasticsearch is exposed on
ES_PORT=9200

# Host port that Kibana is exposed on
KIBANA_PORT=5601

# Memory limit per container — e.g. 1073741824 (1 GB) or 2g
# On Windows/macOS Docker Desktop, set this to half the memory
# allocated to the Docker VM in Docker Desktop settings.
MEM_LIMIT=1073741824
